[server]
name=Z0BDbg MCP Server
version=1.0
protocol_version=2024-11-05

[http]
bind=127.0.0.1
port=8765
auth_token=
auto_start=1

[remote]
url=https://example.com/mcp
transport=streamable-http
token=
headers=
auto_connect=0
auto_reconnect=1
retry_interval_ms=3000
max_retries=0
timeout_ms=30000
verify_tls=1

[cache]
enabled=1
ttl_seconds=300
max_kb=1024

[model]
; Capability hints: unknown context window=0; quality is a user supplied score.
context_tokens=0
quality=50
latency_ms=5000
tool_calls=1
url=https://api.openai.com/v1/chat/completions
name=gpt-6-sol
api_key=
max_tool_rounds=5
history_limit=24
stream_output=0
input_price=
output_price=
cached_input_price=
price_currency=USD

[memory]
min_confidence=0
enabled=1
; Local normalized hashed-term vectors. Semantic reranking remains optional.
vector=1
candidates=64
cache_seconds=300
; Explicit opt-in: reranks all scoped candidates in batches of 32 excerpts.
semantic=0
project=default
project_path=
hits=5
context_kb=8

[isolation]
; Empty allowlists deny the corresponding access when strict=1.
strict=0
require_remote=0
; Existing absolute directories and HTTP(S) origins, separated by |.
files=
network=
; Target guard applies to ordinary chat and JSON-RPC as well as managed tasks.
target=0
; Empty permits catalog tools, subject to permission_mode and project policy.
; Example: get_debug_context,get_status,get_cpu_thread_id,read_memory,disassemble
tools=
calls=128
argument_kb=64
result_kb=256

[evaluation]
enabled=1
stream_usage=0

[agent]
auto_route=0
; 0=keyword, 1=balanced, 2=quality, 3=economy, 4=latency.
routing_mode=0
failover=0
review=0
task_mode=0
task_retries=2
task_replans=2
task_rounds=32
task_timeout_seconds=3600
read_retries=2
parallel_workers=1
event_wait_seconds=30
debug_guard=1
collaboration=0
coordinator=0

[context]
context_auto=1
context_budget_kb=192
context_recent=6
tool_result_kb=8
context_summary_kb=4

[budget]
; 0/empty disables a limit. Token admission uses conservative UTF-8 estimates.
context_tokens=0
task_tokens=0
; Cost needs input/output prices per million tokens in the same currency.
task_cost=
currency=USD

[permissions]
; 0=read-only, 1=confirm modifications, 2=allow modifications.
; Dangerous and unknown operations always require interactive confirmation.
mode=1

[queue]
workers=1
slice_seconds=60
max_slices=10

[storage]
quota_mb=512

[security]
; Require user confirmation for modifying tools even with permissions mode=2.
sensitive_guard=1

[embedding]
; Opt-in: sends scoped knowledge excerpts/query to this endpoint; provider may bill.
enabled=0
url=
model=
api_key=
revision=v1
input_price=
batches=2

[agent_model_1]
context_tokens=0
quality=50
latency_ms=5000
tool_calls=1
input_price=
output_price=
cached_input_price=
price_currency=USD
enabled=0
url=
name=
api_key=
reasoning_effort=auto
timeout_seconds=120
keywords=
reviewer=0

[agent_model_2]
context_tokens=0
quality=50
latency_ms=5000
tool_calls=1
input_price=
output_price=
cached_input_price=
price_currency=USD
enabled=0
url=
name=
api_key=
reasoning_effort=auto
timeout_seconds=120
keywords=
reviewer=0

[agent_model_3]
context_tokens=0
quality=50
latency_ms=5000
tool_calls=1
input_price=
output_price=
cached_input_price=
price_currency=USD
